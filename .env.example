# Server-only configuration. Never prefix these with NEXT_PUBLIC_.

# Studio AI (optional)
ANTHROPIC_API_KEY=
# Choose a model available to your Anthropic account.
ANTHROPIC_MODEL=

# Required for Studio AI and Agent Relay. Generate at least 24 random
# characters and enter the same value in the app's Settings.
STUDIO_ACCESS_TOKEN=

# Agent Relay (optional): the full connector URL from your Agent Relay
# deployment, including its secret token, e.g.
# https://agent-relay-one.vercel.app/api/mcp/<MCP_SECRET>
RELAY_MCP_URL=
